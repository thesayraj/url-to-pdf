/dist
/build
*.js.map
*.d.ts.map

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# other
package-lock.json

# Coverage directory
coverage

# Optional caches and other temporary files
.cache
.eslintcache
.nyc_output
*.tgz # npm pack output
.node_repl_history

# OS and IDE files
.DS_Store # macOS
.vscode/ # VS Code configuration (optional, if you want to share workspace settings)
